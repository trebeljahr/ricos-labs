# The site needs no environment variable in local development.
# This file lists the variables that the code reads.

# Set by the Docker build from the DEPLOYMENT_ID build argument (see the
# Dockerfile). Both hold the full commit SHA of the release. Leave them
# unset in local development.
#
# next.config.mjs passes this one to Next as the deployment id:
# NEXT_DEPLOYMENT_ID=
#
# src/app/layout.tsx renders this one as the `build-commit` meta tag:
# NEXT_PUBLIC_BUILD_COMMIT=

# Read by the local-dev plugin in next.config.mjs. Set it to 0 on the
# command line to start a second dev server that leaves the dev URL alone
# (see docs/dev-setup.md):
# HATCHKIT_LOCAL_DEV=0

# Production values live in .env.production, encrypted with dotenvx.
