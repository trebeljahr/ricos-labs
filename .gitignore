# Dependencies
node_modules/

# Build output
dist/
.next/
.turbo/

# Environment (committed: .env.example, .env.development, AND
#              .env.production — because production values are
#              encrypted via dotenvx, not plaintext).
#
# .env.keys must NEVER be committed — it contains the private keys
# that decrypt the encrypted values in .env.production.
.env
.env.local
.env.keys
.env.*.local

# IDE
.vscode/
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Testing
test-results/
playwright-report/
coverage/

# Docker
.docker-data/

# TypeScript
*.tsbuildinfo

# Misc
*.log
npm-debug.log*

# Static export (with its version.json) and Wrangler state
/packages/client/out/
.wrangler/
