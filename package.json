{
  "name": "ricos-labs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @starter/client dev",
    "build": "pnpm --filter @starter/client run build",
    "build:client": "pnpm --filter @starter/client run build",
    "test": "pnpm run test:client",
    "test:client": "pnpm --filter @starter/client run test",
    "typecheck": "pnpm -r run typecheck",
    "screenshots": "node scripts/capture-project-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.4",
    "mongodb": "^6.21.0",
    "typescript": "^5.9.3"
  }
}
